{
  "extends": "flarum-tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "jsx": "react",
    "jsxFactory": "m",
    "jsxFragmentFactory": "m.Fragment",
    "baseUrl": ".",
    "paths": { "flarum/*": [".flarum-typings/*"] }
  },
  "include": ["src/**/*", "admin.ts", "forum.ts", ".flarum-typings/@types/**/*"]
}
