{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "jsxFactory": "m",
    "jsxFragmentFactory": "m.Fragment",
    "baseUrl": ".",
    "paths": { "flarum/*": [".flarum-typings/*"] }
  },
  "include": ["src/**/*", "admin.ts", "forum.ts", ".flarum-typings/@types/**/*"]
}
